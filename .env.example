# Postgres connection (Supabase: use the "Connection string" from Project Settings > Database)
DATABASE_URL=

# Which LLM provider to use for answers + guess classification. "gemini" or "groq".
LLM_PROVIDER=groq

# Google Gemini API key (https://aistudio.google.com/apikey) — free tier, no card required.
# Used for both the yes/no answer calls and (by default) text embeddings.
#GEMINI_API_KEY=

MISTRAL_API_KEY=

# Groq API key (https://console.groq.com/keys) — free tier, used if LLM_PROVIDER=groq.
# Note: Groq has no embeddings endpoint, so GEMINI_API_KEY is still required for embeddings
# even when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Simple shared-secret used to protect the /api/admin/* routes. Send it as
# `Authorization: Bearer <this value>` from the admin page.
ADMIN_TOKEN=

# Signs the round token for the Two Truths Special Case mode (which job is
# secretly the answer, tamper-proof, stateless). Falls back to ADMIN_TOKEN,
# then a hardcoded dev string, if unset — set this explicitly for production.
TWO_TRUTHS_SECRET=